[Unit]
Description=TalkToHermes dedicated OmniVoice service (user)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
UMask=0077
WorkingDirectory=%h/.local/opt/talktohermes-omnivoice/current
Environment=PYTHONPATH=%h/.local/opt/talktohermes-omnivoice/current/src
Environment=HF_HUB_CACHE=%h/.local/share/talktohermes-omnivoice/model
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=XDG_CACHE_HOME=%h/.cache/talktohermes-omnivoice
Environment=PYTHONNOUSERSITE=1
ExecStart=%h/.local/opt/talktohermes-omnivoice/venv/bin/python -m talktohermes_omnivoice.cli --config %h/.config/talktohermes-omnivoice/config.yaml
Restart=on-failure
RestartSec=5s
TimeoutStartSec=10min
TimeoutStopSec=2min
KillSignal=SIGTERM
KillMode=mixed

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=false
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
ReadWritePaths=%h/.cache/talktohermes-omnivoice
MemoryMax=24G
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=default.target
