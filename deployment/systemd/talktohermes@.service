[Unit]
Description=TalkToHermes bridge for %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/opt/talktohermes/current/backend
ExecStart=/opt/talktohermes/current/backend/.venv/bin/talktohermes-production /etc/talktohermes/%i.yaml
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
KillSignal=SIGTERM
KillMode=mixed
UMask=0077

StateDirectory=talktohermes/%i
StateDirectoryMode=0700
ReadWritePaths=/var/lib/talktohermes/%i

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/%i/.hermes
BindReadOnlyPaths=/home/%i/.local/share/uv/python
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
