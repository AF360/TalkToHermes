[Unit]
Description=Dedicated TalkToHermes STT
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/opt/talktohermes-stt/current/services/stt
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONPATH=/opt/talktohermes-stt/vendor:/opt/talktohermes-stt/current/services/stt/src
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=HF_DATASETS_OFFLINE=1
Environment=LD_LIBRARY_PATH=/opt/stt/.venv/lib/python3.11/site-packages/nvidia/cudnn/lib:/opt/stt/.venv/lib/python3.11/site-packages/nvidia/cublas/lib
Environment=TALKTOHERMES_STT_TOKEN_FILE=%h/.config/talktohermes-stt/token
ExecStart=/opt/stt/.venv/bin/python -m gunicorn --workers 1 --threads 1 --worker-class sync --bind 127.0.0.1:5050 --timeout 120 --graceful-timeout 20 --limit-request-line 1024 --limit-request-fields 20 --limit-request-field_size 512 --access-logfile /dev/null --error-logfile - talktohermes_stt.runtime:app
Restart=on-failure
RestartSec=5s
TimeoutStartSec=120s
TimeoutStopSec=25s
KillSignal=SIGTERM
KillMode=mixed
UMask=0077

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=false
MemoryDenyWriteExecute=false
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
KeyringMode=private
RemoveIPC=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET
SystemCallArchitectures=native
TasksMax=64
LimitNOFILE=1024
MemoryMax=16G

[Install]
WantedBy=default.target
